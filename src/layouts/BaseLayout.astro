---
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';
import Header from '../features/navigation/Header.astro';
import Footer from '../features/navigation/Footer.astro';
interface Props { title: string; description?: string; noindex?: boolean; canonicalPath?: string; }
const { title, description = 'Oleh Savchenko - GenAI applications, data analytics and AI robotics. Projects, experience and articles.', noindex = false, canonicalPath } = Astro.props;
const canonical = new URL(canonicalPath || Astro.url.pathname, Astro.site);
const pageTitle = title === 'Home' ? 'Oleh Savchenko - GenAI & Data' : `${title} - Oleh Savchenko`;
const socialImage = new URL('/social-card.png', Astro.site);
const structuredData = { '@context': 'https://schema.org', '@type': 'Person', name: 'Oleh Savchenko', url: String(Astro.site), sameAs: ['https://github.com/olegqm', 'https://www.linkedin.com/in/oleh-savchenko-12194127b'], knowsAbout: ['Generative AI', 'Data Analytics', 'Computer Vision', 'Robotics'] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f3ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141b1a" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Oleh Savchenko - GenAI & Data" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let saved;
        try { saved = localStorage.getItem('oleh-portfolio-theme'); } catch {}
        root.dataset.theme = saved === 'light' || saved === 'dark' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
