---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ProjectVisual from '../features/projects/ProjectVisual.astro';
import Icon from '../components/ui/Icon.astro';
import Gallery from '../features/media/Gallery.astro';
import ProjectVideo from '../features/media/ProjectVideo.astro';
import { galleries } from '../features/media/galleries';
import { projectUrl } from '../features/projects/data';
interface Props { project: CollectionEntry<'projects'>; next: CollectionEntry<'projects'>; }
const { project, next } = Astro.props;
const { data } = project;
---
<BaseLayout title={data.title} description={data.summary}>
  <header class="container case-hero"><a class="text-link back-link" href="/projects/"><Icon name="arrow" size={17} /> All projects</a><div class="case-title-top"><span class="eyebrow">{String(data.order).padStart(2, '0')} / {data.category}</span><span class="eyebrow">{data.context}</span></div><h1>{data.title}<span class="accent-dot">.</span></h1><p class="lead">{data.summary}</p><div class="case-meta"><div><span class="eyebrow">My role</span><p>{data.role}</p></div><div><span class="eyebrow">Focus</span><p>{data.focus.join(' · ')}</p></div></div></header>
  <div class="container case-cover"><ProjectVisual kind={data.kind} priority /></div>
  <div class="container case-content-grid"><aside class="case-sidebar"><span class="eyebrow">Tools & technologies</span><div class="tag-list">{data.technologies.map(technology => <span class="tag">{technology}</span>)}</div><a class="text-link" href="/contact/">Let's talk <Icon name="external" size={16} /></a></aside><article class="prose"><slot /></article></div>
  <div class="container case-media"><Gallery images={galleries[project.id] || []} id={project.id} title={data.kind === 'genai' ? 'The sign-in experience.' : 'Out in the field.'} />{data.kind === 'robotics' && <ProjectVideo />}</div>
  <section class="container next-project"><span class="eyebrow">Next project / {String(next.data.order).padStart(2, '0')}</span><a href={projectUrl(next.id)}><h2>{next.data.title}</h2><span class="circle-arrow"><Icon name="arrow" size={28} /></span></a></section>
</BaseLayout>
