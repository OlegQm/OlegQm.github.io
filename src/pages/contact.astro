---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../content/profile';
import Icon from '../components/ui/Icon.astro';
---
<BaseLayout title="Contact" description="Contact Oleh Savchenko by email, LinkedIn or GitHub.">
  <section class="container page-hero contact-hero"><h1>Get in <em>touch.</em></h1></section>
  <section class="container contact-options" aria-label="Contact links">
    <div class="contact-email-group">
      <a class="contact-option contact-email-link" href={`mailto:${profile.email}`} aria-label={`Email ${profile.email}`}>
        <div><h2>Email</h2><p>{profile.email}</p></div><Icon name="mail" size={28} />
      </a>
      <button class="contact-copy-button" type="button" data-copy-email={profile.email} aria-label="Copy email address" title="Copy email address"><Icon name="copy" size={21} /></button>
    </div>
    <a class="contact-option" href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn - professional background (opens in a new tab)"><div><h2>LinkedIn</h2><Icon name="external" size={28} /></div></a>
    <a class="contact-option" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub - profile (opens in a new tab)"><div><h2>GitHub</h2><Icon name="external" size={28} /></div></a>
    <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
  </section>
</BaseLayout>
<script>
  import '../features/contact/copy-email';
</script>
