---
import { render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { getProjects } from '../../features/projects/data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({ params: { slug: project.id }, props: { project, next: projects[(index + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
const { Content } = await render(project);
---
<ProjectLayout project={project} next={next}><Content /></ProjectLayout>
