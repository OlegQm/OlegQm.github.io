---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import ProjectVisual from '../features/projects/ProjectVisual.astro';
import ProjectCard from '../features/projects/ProjectCard.astro';
import ContactBanner from '../components/ui/ContactBanner.astro';
import { getProjects } from '../features/projects/data';
const projects = await getProjects();
---
<BaseLayout title="Home">
  <section class="home-hero container" aria-labelledby="hero-title">
    <div class="hero-copy"><div class="eyebrow hero-intro"><span class="status-dot"></span> Oleh Savchenko / GenAI & Data</div><h1 id="hero-title">Making AI<br />work in the<br /><em>real world.</em></h1><p class="hero-description">I build GenAI applications, work with data, and explore what happens when AI meets robotics.</p><div class="hero-buttons"><a href="/projects/" class="button button-dark">Explore my work <Icon name="arrow" /></a><a href="/about/" class="text-link">A little about me <Icon name="external" size={18} /></a></div><div class="hero-location"><span class="coordinate-mark" aria-hidden="true">+</span> Based in Bratislava · Looking across Europe</div></div>
    <div class="hero-project"><div class="hero-image-top"><span class="eyebrow">A closer look</span><span class="eyebrow">01 / Robotics</span></div><a href="/projects/ai-robotics-manipulator/" class="hero-image-link" aria-label="Explore the AI and Robotics Manipulator project"><ProjectVisual kind="robotics" priority /></a><div class="hero-image-caption"><div><span class="eyebrow">Personal project</span><p>AI, beyond the screen.</p></div><a class="icon-button" href="/projects/ai-robotics-manipulator/" aria-label="View AI and Robotics Manipulator"><Icon name="external" size={24} /></a></div><span class="hero-note">Computer vision. Edge hardware. Physical movement.</span></div>
  </section>
  <div class="expertise-strip"><div class="container"><span>GenAI applications</span><span aria-hidden="true">✳</span><span>Data & analytics</span><span aria-hidden="true">✳</span><span>AI × Robotics</span><span aria-hidden="true">✳</span><span>Always learning</span></div></div>
  <section class="container selected-work section-space" aria-labelledby="selected-heading"><div class="section-heading"><div><span class="eyebrow">Selected work / 01—04</span><h2 id="selected-heading">Ideas into<br /><em>working systems.</em></h2></div><p class="section-intro">From university GenAI development to multi-country analytics and hands-on robotics. A look at what I've worked on.</p></div><div class="projects-grid">{projects.map(project => <ProjectCard project={project} />)}</div><a class="text-link section-end-link" href="/projects/">Explore all case studies <Icon name="arrow" /></a></section>
  <section class="approach-section"><div class="container approach-grid"><div><span class="eyebrow">How I work</span><h2>Across the stack.<br /><em>Close to the problem.</em></h2><a href="/about/" class="text-link">Experience & background <Icon name="arrow" /></a></div><div class="approach-list"><article><span class="eyebrow">01 / Applications</span><h3>Connecting AI to people</h3><p>Hands-on GenAI development across Python backends and Vue interfaces, with direct contributions to the STU chatbot.</p></article><article><span class="eyebrow">02 / Data</span><h3>Making data useful</h3><p>Maintaining and developing shared data sources, adding integrations and improving the experience of analytics users.</p></article><article><span class="eyebrow">03 / Exploration</span><h3>Learning by building</h3><p>Robotics and agent projects, alongside ongoing machine learning study and a deeper focus on mathematical foundations.</p></article></div></div></section>
  <ContactBanner />
</BaseLayout>
