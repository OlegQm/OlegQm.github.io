---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../content/profile';
---
<BaseLayout title="About" description="Oleh Savchenko's work in data analytics, full-stack GenAI and computer vision, alongside his Applied Informatics studies at STU.">
  <section class="container page-hero about-hero"><h1>About <em>me.</em></h1><div class="page-hero-bottom about-intro"><p class="lead">I work across data analytics and application development. At BOXYLAND.EU, that means building data pipelines and reports; before that, I helped develop a chatbot for the FEI STU faculty.</p><p>Outside those roles, I built a self-hosted AI workspace for colleagues and a real-time object-tracking robot for a START accelerator project, which I presented to potential investors. I studied Applied Informatics at STU and am currently learning PyTorch and Scikit-Learn.</p></div></section>
  <section class="container about-section" aria-labelledby="experience-heading"><div class="section-heading"><h2 id="experience-heading">Experience<span class="accent-dot">.</span></h2></div><div class="experience-list">{experience.map(job => <article class="experience-row"><div><p class="experience-period">{job.period}</p></div><div><h3>{job.role}</h3><p class="experience-company">{job.company}</p><p class="experience-detail">{job.detail}</p><p>{job.description}</p><div class="tag-list">{job.tags.map(tag => <span class="tag">{tag}</span>)}</div></div></article>)}</div></section>
  <section class="container education-section" aria-labelledby="education-heading"><h2 id="education-heading">Education &<br /><em>learning.</em></h2><div class="education-cards"><article class="education-card"><span class="eyebrow">Jan 2022 - Jun 2026</span><h3>Bachelor's degree<br />Information Technology</h3><p>Faculty of Electrical Engineering and Information Technology<br />Slovak University of Technology in Bratislava</p></article><article class="education-card learning-card"><span class="learning-status"><span class="status-dot"></span> In progress</span><h3>Machine Learning with<br />PyTorch and Scikit-Learn</h3><p>Packt · Coursera</p><p class="course-detail">I’m currently studying PyTorch and Scikit-Learn in this course.</p><div class="tag-list"><span class="tag">Linear algebra</span><span class="tag">Calculus</span><span class="tag">Statistics</span><span class="tag">Probability</span></div></article></div></section>
</BaseLayout>
