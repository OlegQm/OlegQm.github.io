---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../content/profile';
import ContactBanner from '../components/ui/ContactBanner.astro';
---
<BaseLayout title="About" description="Oleh Savchenko's background in data analytics and GenAI full-stack development, education at STU and ongoing machine learning study.">
  <section class="container page-hero about-hero"><span class="eyebrow">A little about me</span><h1>Curiosity,<br /><em>put into practice.</em></h1><div class="page-hero-bottom"><p class="lead">I'm Oleh, based in Bratislava. I work across data analytics and GenAI application development, with a growing focus on machine learning and AI in the physical world.</p><span class="eyebrow">GenAI / Data / Robotics</span></div></section>
  <section class="container about-section" aria-labelledby="experience-heading"><div class="section-heading"><div><span class="eyebrow">Where I've contributed</span><h2 id="experience-heading">Experience<span class="accent-dot">.</span></h2></div></div><div class="experience-list">{experience.map((job, index) => <article class="experience-row"><div><span class="eyebrow">{String(index + 1).padStart(2, '0')}</span><p class="experience-period">{job.period}</p></div><div><h3>{job.role}</h3><p class="experience-company">{job.company}</p><p class="experience-detail">{job.detail}</p><p>{job.description}</p><div class="tag-list">{job.tags.map(tag => <span class="tag">{tag}</span>)}</div></div></article>)}</div></section>
  <section class="container education-section" aria-labelledby="education-heading"><div><span class="eyebrow">The foundation</span><h2 id="education-heading">Education &<br /><em>what comes next.</em></h2></div><div class="education-cards"><article class="education-card"><span class="eyebrow">Jan 2022 — Jun 2026</span><h3>Bachelor's degree<br />Information Technology</h3><p>Faculty of Electrical Engineering and Information Technology<br />Slovak University of Technology in Bratislava</p></article><article class="education-card learning-card"><span class="learning-status"><span class="status-dot"></span> In progress</span><h3>Machine Learning with<br />PyTorch and Scikit-Learn</h3><p>Packt · Coursera</p><p>Building stronger foundations in linear algebra, calculus, statistics and probability alongside practical machine learning study.</p><div class="tag-list"><span class="tag">Linear algebra</span><span class="tag">Calculus</span><span class="tag">Statistics</span><span class="tag">Probability</span></div></article></div></section>
  <section class="container direction-section"><span class="eyebrow">Looking ahead</span><h2>Growing toward<br /><em>AI & ML engineering.</em></h2><p class="lead">My GenAI and data experience is the starting point. I'm developing my machine learning skills and targeting mid-level GenAI Engineer and ML Engineer opportunities in Slovakia and across Europe, with hybrid or remote work.</p></section>
  <ContactBanner />
</BaseLayout>
