---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../content/profile';
---
<BaseLayout title="About" description="Oleh Savchenko's background in data analytics and GenAI full-stack development, education at STU and ongoing machine learning study.">
  <section class="container page-hero about-hero"><h1>About <em>me.</em></h1><div class="page-hero-bottom"><p class="lead">I build GenAI applications and data tools in Bratislava. I also study machine learning with PyTorch and Scikit-Learn.</p></div></section>
  <section class="container about-section" aria-labelledby="experience-heading"><div class="section-heading"><h2 id="experience-heading">Experience<span class="accent-dot">.</span></h2></div><div class="experience-list">{experience.map(job => <article class="experience-row"><div><p class="experience-period">{job.period}</p></div><div><h3>{job.role}</h3><p class="experience-company">{job.company}</p><p class="experience-detail">{job.detail}</p><p>{job.description}</p><div class="tag-list">{job.tags.map(tag => <span class="tag">{tag}</span>)}</div></div></article>)}</div></section>
  <section class="container education-section" aria-labelledby="education-heading"><h2 id="education-heading">Education &<br /><em>learning.</em></h2><div class="education-cards"><article class="education-card"><span class="eyebrow">Jan 2022 — Jun 2026</span><h3>Bachelor's degree<br />Information Technology</h3><p>Faculty of Electrical Engineering and Information Technology<br />Slovak University of Technology in Bratislava</p></article><article class="education-card learning-card"><span class="learning-status"><span class="status-dot"></span> In progress</span><h3>Machine Learning with<br />PyTorch and Scikit-Learn</h3><p>Packt · Coursera</p><div class="tag-list"><span class="tag">Linear algebra</span><span class="tag">Calculus</span><span class="tag">Statistics</span><span class="tag">Probability</span></div></article></div></section>
  <section class="container direction-section"><h2>Target <em>roles.</em></h2><p class="lead">Mid-level GenAI Engineer and ML Engineer roles in Slovakia and Europe, hybrid or remote.</p></section>
</BaseLayout>
