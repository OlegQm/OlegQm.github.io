---
import type { CollectionEntry } from 'astro:content';
import Icon from '../../components/ui/Icon.astro';
import ProjectVisual from './ProjectVisual.astro';
import { projectUrl } from './data';
interface Props { project: CollectionEntry<'projects'>; featured?: boolean; }
const { project, featured = false } = Astro.props;
const { data } = project;
---
<article class:list={['project-card', { 'project-card-featured': featured }]}>
  <a href={projectUrl(project.id)} class="project-card-link" aria-label={`View case study: ${data.title}`}>
    <ProjectVisual kind={data.kind} />
    <div class="project-card-body"><div class="project-card-meta"><span class="eyebrow">{data.category}</span><span class="circle-arrow"><Icon name="arrow" /></span></div><h3>{data.title}</h3><p>{data.summary}</p></div>
  </a>
</article>
