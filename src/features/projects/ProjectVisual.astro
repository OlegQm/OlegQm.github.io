---
import { Image } from 'astro:assets';
import robot from '../../assets/manipulator-field-test.png';
interface Props { kind: 'robotics' | 'genai' | 'data' | 'agents'; priority?: boolean; }
const { kind, priority = false } = Astro.props;
---
<div class:list={['project-visual', `visual-${kind}`]}>
  {kind === 'robotics' ? <>
    <Image src={robot} alt="Purple robotic manipulator during an outdoor field test" widths={[480, 800, 1200, 1600]} sizes="(max-width: 767px) 100vw, 60vw" format="webp" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
    <span class="visual-label"><span class="status-dot"></span> Field notes / AI × Robotics</span>
  </> : kind === 'genai' ? <div class="artwork artwork-genai" aria-hidden="true"><span class="artwork-kicker">Language → possibility</span><div class="orb orb-one"></div><div class="orb orb-two"></div><div class="orb orb-three"></div><span class="artwork-word">Hello<span>_</span></span><span class="artwork-caption">GEN AI / FULL STACK</span><span class="artwork-cross">+</span></div>
  : kind === 'data' ? <div class="artwork artwork-data" aria-hidden="true"><span class="artwork-kicker">Finding the shared picture</span><div class="data-lines">{[3, 5, 2, 7, 4, 6, 3, 8, 5, 7, 4, 6].map((height, index) => <span style={`--bar:${height};--index:${index}`}></span>)}</div><div class="artwork-baseline"></div><span class="artwork-caption">DATA / ANALYTICS</span><span class="artwork-cross">+</span></div>
  : <div class="artwork artwork-agents" aria-hidden="true"><span class="artwork-kicker">Small hardware. New possibilities.</span><div class="agent-orbits"><span></span><span></span><span></span><i></i><i></i><b>ai</b></div><span class="artwork-caption">AGENTS / EDGE COMPUTING</span><span class="artwork-cross">+</span></div>}
</div>
