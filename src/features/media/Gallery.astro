---
import { Image, getImage } from 'astro:assets';
import Icon from '../../components/ui/Icon.astro';
import type { GalleryImage } from './galleries';
interface Props { images: GalleryImage[]; id: string; title?: string; }
const { images, id, title = 'A closer look' } = Astro.props;
const slides = await Promise.all(images.map(async item => ({ src: (await getImage({ src: item.image, width: Math.min(item.image.width, 1920), format: 'webp' })).src, alt: item.alt, caption: item.caption })));
---
{images.length > 0 && <section class="gallery-section" aria-labelledby={`${id}-heading`}><div class="section-heading"><div><span class="eyebrow">Project images</span><h2 id={`${id}-heading`}>{title}</h2></div><span class="small-note">Select an image to explore</span></div><image-gallery data-slides={JSON.stringify(slides)}><div class="gallery-grid">{images.map((item, index) => <figure><a href={slides[index].src} class="gallery-trigger" data-slide={index} aria-label={`Enlarge: ${item.caption}`}><Image src={item.image} alt={item.alt} widths={[390, 720, 1200]} sizes="(max-width: 767px) 100vw, 50vw" format="webp" loading="lazy" /><span class="gallery-expand" aria-hidden="true"><Icon name="external" /></span></a><figcaption>{item.caption}</figcaption></figure>)}</div><dialog class="gallery-dialog" aria-labelledby={`${id}-caption`}><div class="gallery-dialog-top"><span data-counter></span><button type="button" class="icon-button" aria-label="Close image viewer" data-close><Icon name="close" /></button></div><div class="gallery-stage"><img data-full-image alt="" /></div><div class="gallery-dialog-bottom"><button type="button" class="icon-button gallery-previous" aria-label="Previous image" data-previous><Icon name="arrow" /></button><p id={`${id}-caption`} data-caption aria-live="polite"></p><button type="button" class="icon-button" aria-label="Next image" data-next><Icon name="arrow" /></button></div></dialog></image-gallery></section>}
<script>
  import './gallery';
</script>
