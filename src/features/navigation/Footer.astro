---
import { profile } from '../../content/profile';
import Icon from '../../components/ui/Icon.astro';
---
<footer class="site-footer">
  <div class="container footer-top">
    <div><a class="footer-name" href="/">Oleh Savchenko<span class="accent-dot">.</span></a><p>GenAI, data and the curiosity to keep building.</p></div>
    <a class="text-link" href="/contact/">Let's connect <Icon name="external" /></a>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getUTCFullYear()} Oleh Savchenko</span><span>Bratislava · Slovakia & Europe</span><div><a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)">GitHub</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">LinkedIn</a></div></div>
</footer>
